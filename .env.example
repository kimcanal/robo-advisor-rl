# Copy to .env and fill in locally. Never commit real secrets.
# Educational project placeholders — not used by RL core yet.

# LLM / research (RAG team)
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here

# Optional market-data providers (when not using yfinance / local CSV)
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
POLYGON_API_KEY=your-polygon-key

# App
API_BASE_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO

# Safety: keep false unless you intentionally enable live broker hooks (none yet)
ENABLE_LIVE_TRADING=false
